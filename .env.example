# AquaLens AI - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Service configuration
PROJECT_NAME="AquaLens AI"
ENVIRONMENT="development"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local SQLite development (default):
DATABASE_URL="sqlite:///./aqualens.db"
# For PostgreSQL with PostGIS in production/staging:
# DATABASE_URL="postgresql://aqualens_user:aqualens_password@localhost:5432/aqualens_db"

# Machine Learning & Fingerprint Thresholds
BASELINE_MIN_OBSERVATIONS=5
ANOMALY_Z_THRESHOLD=2.5

# API & Frontend URLs
API_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"

# ============================================================
# Satellite acquisition - Google Earth Engine (Sentinel-2 L2A)
# ============================================================
# The Google Cloud project that has the Earth Engine API enabled.
# Leave blank to keep satellite retrieval disabled; every other feature still works.
GEE_PROJECT_ID=""

# Absolute path to a service-account JSON key, for unattended backend execution.
# Keep the file OUTSIDE this repository and never commit it. Leave blank to use
# Application Default Credentials (local development: run `earthengine authenticate` once).
GOOGLE_APPLICATION_CREDENTIALS=""

# Satellite collection and defaults. Never place credentials in VITE_* variables.
SATELLITE_COLLECTION="COPERNICUS/S2_SR_HARMONIZED"
SATELLITE_DEFAULT_BUFFER_M=300
SATELLITE_DEFAULT_MONTHS=24
