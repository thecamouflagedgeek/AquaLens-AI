# AquaLens AI - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Service configuration
PROJECT_NAME="AquaLens AI"
ENVIRONMENT="development"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local SQLite development (default):
DATABASE_URL="sqlite:///./aqualens.db"
# For PostgreSQL with PostGIS in production/staging:
# DATABASE_URL="postgresql://aqualens_user:aqualens_password@localhost:5432/aqualens_db"

# Machine Learning & Fingerprint Thresholds
BASELINE_MIN_OBSERVATIONS=5
ANOMALY_Z_THRESHOLD=2.5

# API & Frontend URLs
API_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"
